+import { guideBuildAdapter } from "../../guide-build-adapter";
+import { createGuideFixture } from "../../guide-fixture";
+import {
+  commitGuide,
+  createGuideHistory,
+  stepGuideHistory,
+  type AppliedGuide
+} from "../../guide-history";
+import {
+  createPersistedBuildSnapshot,
+  hydrateEditorFromSnapshot,
+  type PersistedBuildSnapshot
+} from "../../persistence-schema";
+import { editorReducer, type EditorAction } from "../../editor-state";
+import { selectSkillDisplay, selectValidationView } from "../../editor-selectors";
+import { ComposerHeader } from "../ComposerHeader";
+import { FocusedAttributeEditor } from "../FocusedAttributeEditor";
+import { GuideEditor } from "./GuideEditor";
+import "./guide.css";
+const catalogs = requireReadyCatalogs();
+export default function GuideFeasibility() {
+  const [history, setHistory] = useState(() =>
+    createGuideHistory(createGuideFixture(), "feasibility-session")
+  );
+  const [source, setSource] = useState("");
+  const [message, setMessage] = useState(
+    "Memory-only feasibility experiment. Existing drafts are untouched."
+  );
+  const [selected, setSelected] = useState("gb-flare");
+  const [composing, setComposing] = useState(false);
+  const [inputEvidence, setInputEvidence] = useState<string[]>([]);
+  const inputTrace = useRef<string[]>([]);
+  useEffect(() => {
+    const record = (event: Event) => {
+      const input = event as InputEvent;
+      const line = `${event.type}: ${input.inputType ?? ""} data=${JSON.stringify(input.data ?? null)} composing=${input.isComposing ?? false} trusted=${event.isTrusted}${event.isTrusted ? "" : ` stack=${new Error().stack}`}`;
+      inputTrace.current = [...inputTrace.current.slice(-49), line];
+    };
+    const names = [
+      "compositionstart",
+      "compositionupdate",
+      "compositionend",
+      "beforeinput",
+      "input"
+    ];
+    for (const name of names) window.document.addEventListener(name, record, true);
+    return () => {
+      for (const name of names) window.document.removeEventListener(name, record, true);
+    };
+  }, []);
+  const editorRef = useRef<Editor | null>(null);
+  const [hasBookmark, setHasBookmark] = useState(false);
+  const bookmark = useRef<SelectionBookmark | null>(null);
+  const document = history.frame.document;
+  const build = guideBuilds(document).find((node) => node.id === selected);
+  const inspector = build ? hydrateEditorFromSnapshot(build.snapshot) : null;
+  const change = (next: AppliedGuide, typing = false) =>
+    setHistory((current) =>
+      commitGuide(current, { document: next, recovery: null }, current, typing ? "typing" : null)
+    );
+  const undo = (direction: "undo" | "redo") =>
+    setHistory((current) => stepGuideHistory(current, direction));
+  const bindEditor = useCallback((editor: Editor | null) => {
+    editorRef.current = editor;
+    if (!editor) return;
+    editor.on("selectionUpdate", ({ editor }) => {
+      bookmark.current = editor.state.selection.getBookmark();
+      setHasBookmark(true);
+    });
+    editor.on("transaction", ({ transaction }) => {
+      if (bookmark.current) bookmark.current = bookmark.current.map(transaction.mapping);
+    });
+  }, []);
+  const edit = (action: EditorAction) => {
+    if (!inspector || !build) return;
+    const next = createPersistedBuildSnapshot(editorReducer(inspector, action));
+    if (JSON.stringify(next) === JSON.stringify(build.snapshot)) return;
+    change({
+      ...document,
+      nodes: document.nodes.map((node) => (node === build ? { ...build, snapshot: next } : node))
+    });
+  };
+  const renderSkill = (node: Extract<GuideNode<PersistedBuildSnapshot>, { type: "skill" }>) => {
+    const sourceBuild =
+      node.context.kind === "local"
+        ? guideBuilds(document).find(
+            (b) => node.context.kind === "local" && b.id === node.context.buildId
+          )
+        : null;
+    const skillId = catalogId<"Skill">(Number(node.skillId.split(":").at(-1)));
+    const skill = catalogs.skills.find((skill) => skill.id === skillId);
+    const view = sourceBuild
+      ? selectSkillDisplay(
+          catalogs,
+          hydrateEditorFromSnapshot(sourceBuild.snapshot),
+          skillId,
+          "tooltip",
+          null
+        )
+      : null;
+    return (
+      <span
+        tabIndex={0}
+        title={
+          view?.kind === "known"
+            ? `${sourceBuild?.snapshot.build.name}: ${view.tooltipText}`
+            : `${node.context.kind}: ${skill?.name ?? node.skillId}`
+        }
+      >
+        {skill?.name ?? node.skillId}{" "}
+        <small>
+          (
+          {node.context.kind === "local"
+            ? (sourceBuild?.snapshot.build.name ?? "missing build")
+            : node.context.kind}
+          )
+        </small>
+      </span>
+    );
+  };
+  return (
+    <main
+      className="guide-experiment"
+      onKeyDown={(event) => {
+        if (
+          event.defaultPrevented ||
+          event.target instanceof HTMLTextAreaElement ||
+          composing ||
+          event.nativeEvent.isComposing
+        )
+          return;
+        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "z") {
+          event.preventDefault();
+          event.stopPropagation();
+          undo(event.shiftKey ? "redo" : "undo");
+        }
+      }}
+    >
+      <header>
+        <h1>Guide feasibility</h1>
+        <p role="status">{message}</p>
+        <p>
+          Revision {history.revision}; undo {history.past.length}; redo {history.future.length}
+        </p>
+        <details>
+          <summary>Native input evidence</summary>
+          <button onClick={() => setInputEvidence([...inputTrace.current])}>
+            Read input trace
+          </button>
+          <pre aria-label="Native input evidence">{inputEvidence.join("\n")}</pre>
+        </details>
+        <button disabled={composing} onClick={() => undo("undo")}>
+          Undo guide
+        </button>
+        <button disabled={composing} onClick={() => undo("redo")}>
+          Redo guide
+        </button>
+        <button disabled={composing} onClick={() => change(createGuideFixture())}>
+          Replace document
+        </button>
+        <button disabled={composing} onClick={() => change(createGuideFixture(true))}>
+          Long fixture
+        </button>
+        <button disabled={composing} onClick={() => setSource(serializeGuideMarkdown(document))}>
+          Open source
+        </button>
+      </header>
+      <div className="guide-experiment-layout">
+        <article>
+          <div className="guide-toolbar">
+            <button onClick={() => editorRef.current?.chain().focus().toggleBold().run()}>
+              Bold
+            </button>
+            <button onClick={() => editorRef.current?.chain().focus().toggleBulletList().run()}>
+              List
+            </button>
+          </div>
+          <GuideEditor
+            document={document}
+            onChange={change}
+            onHistory={undo}
+            onEditor={bindEditor}
+            onComposition={setComposing}
+            renderSkill={renderSkill}
+            renderBuild={(id) => {
+              const card = guideBuilds(document).find((node) => node.id === id);
+              if (!card) return "Missing build";
+              return (
+                <section aria-label={card.snapshot.build.name}>
+                  <button onClick={() => setSelected(id)}>{card.snapshot.build.name}</button>
+                  <p>
+                    {card.snapshot.build.mode}; Fire Magic{" "}
+                    {card.snapshot.build.attributes[0]?.rank ?? 0}
+                  </p>
+                  <div className="guide-bar">
+                    {card.snapshot.build.skillBar.map((skillId, index) => (
+                      <span key={index}>
+                        {skillId
+                          ? (catalogs.skills.find((skill) => skill.id === skillId)?.name ?? skillId)
+                          : "Empty"}
+                      </span>
+                    ))}
+                  </div>
+                </section>
+              );
+            }}
+          />
+        </article>
+        <aside aria-label="Guide catalog">
+          <h2>Skills catalog</h2>
+          <p>{hasBookmark ? "Insert at remembered caret" : "Choose a caret or insert at end"}</p>
+          <button
+            onClick={() => {
+              const editor = editorRef.current;
+              if (!editor || !bookmark.current) {
+                setMessage("Choose a text caret first.");
+                return;
+              }
+              const selection = bookmark.current.resolve(editor.state.doc);
+              editor
+                .chain()
+                .focus()
+                .setTextSelection({ from: selection.from, to: selection.to })
+                .insertContent({
+                  type: "guideSkill",
+                  attrs: { skillId: "catalog:skill:194", context: { kind: "generic" } }
+                })
+                .run();
+            }}
+          >
+            Insert generic Flare at caret
+          </button>
+          <button
+            onClick={() =>
+              editorRef.current
+                ?.chain()
+                .focus("end")
+                .insertContent({
+                  type: "paragraph",
+                  content: [
+                    {
+                      type: "guideSkill",
+                      attrs: { skillId: "catalog:skill:194", context: { kind: "generic" } }
+                    }
+                  ]
+                })
+                .run()
+            }
+          >
+            Insert Flare at end
+          </button>
+          {inspector ? (
+            <section aria-label="Selected build inspector">
+              <ComposerHeader
+                state={inspector}
+                catalogs={catalogs}
+                validation={selectValidationView(inspector, catalogs).result}
+                dispatch={edit}
+              />
+              <FocusedAttributeEditor
+                state={inspector}
+                catalogs={catalogs}
+                validation={selectValidationView(inspector, catalogs)}
+                dispatch={edit}
+              />
+            </section>
+          ) : null}
+        </aside>
+      </div>
+      <section>
+        <label>
+          Markdown source
+          <textarea
+            aria-label="Markdown source"
+            value={source}
+            onChange={(event) => setSource(event.target.value)}
+          />
+        </label>
+        <button
+          onClick={() => {
+            const parsed = parseGuideMarkdown(
+              source,
+              guideBuildAdapter(catalogs),
+              () => "guide-imported"
+            );
+            if (parsed.ok) {
+              change(parsed.document);
+              setMessage("Applied source as one transaction.");
+            } else setMessage(parsed.diagnostics.map((item) => item.message).join(" "));
+          }}
+        >
+          Apply source
+        </button>
+      </section>
+    </main>
+  );
+}
