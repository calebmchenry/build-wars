+  readonly nodes: readonly GuideNode<B>[];
+}
+export function guideBuilds<B>(
+  doc: GuideDocument<B>
+): readonly Extract<GuideNode<B>, { type: "build" }>[] {
+  return doc.nodes.filter(
+    (node): node is Extract<GuideNode<B>, { type: "build" }> => node.type === "build"
+  );
+}
