.DS_Store
__pycache__/
*.py[cod]

# Node and build outputs
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example
*.local

# Generated run/log output
*.log
work/runs/

# Future raw/generated data artifacts. Keep policy README files tracked. Future generated-data
# exceptions must be exact-path allowlists with parent-directory unignore rules.
data/source-snapshots/*
!data/source-snapshots/README.md
data/generated/*
!data/generated/README.md
data/qa/*
!data/qa/README.md
