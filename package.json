{
  "name": "build-wars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=11.10.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.domain.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.domain.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build && python3 -m unittest scripts/test_ticket_burn.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
